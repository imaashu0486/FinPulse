# ==============================================================================
# FinPulse AI V4.0 — Environment Variable Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your credentials.
# Refer to docs/CREDENTIAL_SETUP_GUIDE.md for detailed walkthroughs.

# --- Application Core ---
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Strict Provenance & Data Integrity ---
# NON-NEGOTIABLE: In V4.0, DEMO_MODE and ALLOW_SYNTHETIC_DATA must be false in normal operation.
DEMO_MODE=false
ALLOW_SYNTHETIC_DATA=false
DATA_CACHE_TTL_SECONDS=300
DEFAULT_BENCHMARK=^NSEI

# --- Database Storage ---
# For local development: sqlite:///./finpulse.db
# For production (Supabase PostgreSQL): postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./finpulse.db
REDIS_URL=redis://localhost:6379/0

# --- Market Data Provider Configuration ---
# Active provider: 'upstox', 'angelone', 'yfinance', or 'none'
MARKET_DATA_PROVIDER=upstox
ENABLE_LIVE_YFINANCE=true

# Upstox Developer API (OAuth 2.0 Authorization Code Flow)
# Register at: https://developer.upstox.com
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/market/provider/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Angel One SmartAPI (Alternative Provider)
# Register at: https://smartapi.angelbroking.com
# NOTE: Angel One requires your public static IP or dynamic IP whitelisted in developer console.
ANGELONE_API_KEY=your_angelone_api_key_here
ANGELONE_CLIENT_CODE=your_client_code_here
ANGELONE_PASSWORD=your_mpin_or_password_here
ANGELONE_TOTP_KEY=your_base32_totp_secret_here
ANGELONE_REDIRECT_URL=http://localhost:8000/api/v1/market/provider/angelone/callback

# --- Supabase Authentication & Row-Level Security ---
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Obtain JWT Secret from Project Settings -> API -> JWT Settings:
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
AUTH_REQUIRED=false

# --- Generative AI: Google Gemini ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Financial NLP Sentiment Engine ---
# Options: 'lexicon' (instant local Loughran-McDonald) or 'finbert' (HuggingFace transformer)
SENTIMENT_ENGINE=lexicon
FINBERT_MODEL_NAME=ProsusAI/finbert

# --- RAG Embeddings Engine ---
# Options: 'sentence_transformers' (requires sentence-transformers library) or 'dense_vector'
EMBEDDING_PROVIDER=dense_vector
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
